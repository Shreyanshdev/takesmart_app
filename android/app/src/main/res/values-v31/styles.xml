<resources>

    <!-- Base application theme (used after splash is dismissed) — Android 12+ override -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:windowBackground">@android:color/white</item>
    </style>

    <!-- Boot splash theme for Android 12+: customizes the SYSTEM splash screen to be ORANGE (#FF4700) -->
    <style name="BootTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:navigationBarColor">#000000</item>
        <!-- Android 12+ SplashScreen API: ORANGE background + TakeSmart logo -->
        <item name="android:windowSplashScreenBackground">#FF4700</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
    </style>

</resources>
